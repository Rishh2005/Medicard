# Copy to .env and replace every secret before starting. Never commit .env.
MYSQL_DATABASE=medicard
MYSQL_USER=medicard_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=mysql
MYSQL_PORT=3306
MONGODB_URI=mongodb://mongodb:27017/medicard?replicaSet=rs0
JWT_SECRET=
JWT_ISSUER=medicard-api
JWT_AUDIENCE=medicard-clients
PATIENT_HMAC_KEY=
DATA_ENCRYPTION_KEY=
IDENTITY_PUBLIC_KEY=
IDENTITY_TRUSTED_ISSUER=
MEDICARD_AUTH_USERS_JSON={}
ACCESS_TOKEN_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=0
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
